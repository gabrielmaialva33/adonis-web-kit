TZ=UTC
HOST=localhost
PORT=3333
NODE_ENV=development
LOG_LEVEL=info

APP_NAME="Adonis Web Kit"
APP_URL=http://localhost:3333
APP_SOURCE_URL=https://github.com/gabrielmaialva33/adonis-web-kit
APP_KEY=
# Use independent high-entropy secrets in production. During local development,
# these secrets fall back to APP_KEY when omitted.
# ACCESS_TOKEN_SECRET=
# REFRESH_TOKEN_SECRET=
# EMAIL_VERIFICATION_SECRET=
# PASSWORD_RESET_SECRET=
PASSWORD_RESET_TTL_MINUTES=60
JWT_ISSUER=adonis-web-kit
JWT_AUDIENCE=adonis-web-kit
JWT_COOKIE_NAME=token
SESSION_COOKIE_NAME=adonis-web-kit-session

# none | personal. "personal" creates a first workspace for public sign-ups.
REGISTRATION_WORKSPACE_MODE=personal
DEMO_PAGES_ENABLED=true

SESSION_DRIVER=cookie
LIMITER_STORE=database

# Drive (file storage): fs | s3 | spaces | r2 | gcs
DRIVE_DISK=fs

# Database Configuration (PostgreSQL)
# DB_CONNECTION selects the connection in config/database.ts (postgres | sqlite)
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=adonis_web_kit

# Redis (cache + sessions)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis
REDIS_DB=0

# Queue Redis (@rlanz/bull-queue) — falls back to REDIS_* when omitted
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=redis

# Mail Configuration
# MAIL_MAILER: smtp | mailgun
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Adonis Web Kit"

# SMTP Configuration. The bundled Docker environment exposes Mailpit on
# localhost:1025 and its inbox UI on http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Mailgun Configuration (when MAIL_MAILER=mailgun)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain
# MAILGUN_BASE_URL=https://api.mailgun.net/v3

# ---------------------------------------------------------------------------
# Optional integrations (uncomment and fill in as needed)
# ---------------------------------------------------------------------------

# OAuth providers (@adonisjs/ally)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# S3 (when DRIVE_DISK=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=

# DigitalOcean Spaces (when DRIVE_DISK=spaces)
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_REGION=
# SPACES_BUCKET=
# SPACES_ENDPOINT=

# Cloudflare R2 (when DRIVE_DISK=r2)
# R2_KEY=
# R2_SECRET=
# R2_BUCKET=
# R2_ENDPOINT=

# Google Cloud Storage (when DRIVE_DISK=gcs)
# GCS_KEY=
# GCS_BUCKET=