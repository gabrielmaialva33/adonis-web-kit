    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "hotHook": {
    "boundaries": [
      "./app/modules/**/controllers/**/*.ts",
      "./app/shared/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
