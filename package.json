{
  "name": "adonis-web-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node --import=@poppinss/ts-exec ace.js build",
    "dev": "node --import=@poppinss/ts-exec ace.js serve --hmr",
    "test": "node --import=@poppinss/ts-exec ace.js test unit --force-exit",
    "test:e2e": "node --import=@poppinss/ts-exec ace.js test --force-exit",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint \"{app,providers,config,tests,start}/**/*.ts\" --fix --ignore-pattern pnpm-lock.yaml",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "ace": "node --import=@poppinss/ts-exec ace.js",
    "docker": "node --import=@poppinss/ts-exec ace.js migration:run && node --import=@poppinss/ts-exec ace.js db:seed && node bin/server.js"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#events/*": "./app/events/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#extensions/*": "./app/extensions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#interfaces/*": "./app/interfaces/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#repositories/*": "./app/repositories/*.js",
    "#routes/*": "./app/routes/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#shared/*": "./app/shared/*.js",
    "#validations/*": "./app/validations/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/openapi-assertions": "^0.1.1",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "1.4.4",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@swc/core": "^1.15.40",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.4.0",
    "hot-hook": "^1.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.11.1",
    "pino-pretty": "^13.1.1",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@adonisjs/ally": "^6.3.0",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/cache": "^2.1.0",
    "@adonisjs/core": "^7.3.4",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/inertia": "^4.2.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.2.1",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^5.1.1",
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "@google-cloud/storage": "^7.17.0",
    "@hookform/resolvers": "^5.2.1",
    "@inertiajs/react": "^2.1.4",
    "@radix-ui/react-accordion": "^1.2.12",
