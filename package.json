{
  "name": "adonis-web-kit",
  "version": "0.9.0",
  "description": "Opinionated full-stack starter for SaaS and multi-tenant applications with AdonisJS, React, and Inertia.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Gabriel Maia <gabrielmaialva33@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielmaialva33/adonis-web-kit.git"
  },
  "homepage": "https://github.com/gabrielmaialva33/adonis-web-kit#readme",
  "bugs": {
    "url": "https://github.com/gabrielmaialva33/adonis-web-kit/issues"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node --import=@poppinss/ts-exec ace.js build",
    "dev": "node --import=@poppinss/ts-exec ace.js serve --hmr",
    "test": "node --import=@poppinss/ts-exec ace.js test unit",
    "test:e2e": "node --import=@poppinss/ts-exec ace.js test",
    "test:ui": "vitest run",
    "test:ui:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint \"{app,providers,config,tests,start}/**/*.ts\" --fix --ignore-pattern pnpm-lock.yaml",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p inertia/tsconfig.json",
    "ace": "node --import=@poppinss/ts-exec ace.js",
    "docker": "node --import=@poppinss/ts-exec ace.js migration:run && node --import=@poppinss/ts-exec ace.js db:seed && node bin/server.js"
  },
  "imports": {
    "#modules/*": "./app/modules/*.js",
    "#shared/*": "./app/shared/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#providers/*": "./providers/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/openapi-assertions": "^0.1.2",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "1.4.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "hot-hook": "^1.0.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-native": "npm:typescript@~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@adonisjs/ally": "^6.3.0",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/cache": "^2.1.0",
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
